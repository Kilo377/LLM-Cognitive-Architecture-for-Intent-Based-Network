f"},{"xapp_id":"xapp_interference_mitigation","name":"Interference Mitigation xApp","version":"2.0.0","description":"Mitigates interference when median SINR is healthy but BLER or drop ratio is elevated. It gently lowers txPowerOffset_dB and may switch beam mode to reduce inter-cell coupling.","entry_point":"xapp_interference_mitigation","execution_type":"periodic","control_parameters":["radio.txPowerOffset_dB","beam.mode"],"kpi_objectives":{},"kpi_constraints":{},"expected_standalone_effect":{},"path":"/Users/kilobao/Documents/MATLAB/Examples/R2025b/5g/5GORAN/oran-sim/xapps/xapp_interference_mitigation","status":"off"},{"xapp_id":"xapp_load_balancing","name":"Load Balancing xApp","version":"2.0.0","description":"Improves fairness by prioritizing backlogged UEs when resource allocation becomes concentrated. It adjusts per-cell UE selection and UE weights based on queue pressure.","entry_point":"xapp_load_balancing","execution_type":"periodic","control_parameters":["scheduling.selectedUE","scheduling.weightUE"],"kpi_objectives":{},"kpi_constraints":{},"expected_standalone_effect":{},"path":"/Users/kilobao/Documents/MATLAB/Examples/R2025b/5g/5GORAN/oran-sim/xapps/xapp_load_balancing","status":"off"},{"xapp_id":"xapp_reliability_coverage","name":"Reliability Coverage xApp","version":"2.0.0","description":"Improves edge-user stability by monitoring p10 SINR, BLER, drop ratio, and RLF count. When edge conditions degrade, it enables adaptive beam mode and modestly raises txPowerOffset_dB to protect coverage. It backs off when conditions recover.","entry_point":"xapp_reliability_coverage","execution_type":"periodic","control_parameters":["beam.mode","radio.txPowerOffset_dB"],"kpi_objectives":{},"kpi_constraints":{},"expected_standalone_effect":{},"path":"/Users/kilobao/Documents/MATLAB/Examples/R2025b/5g/5GORAN/oran-sim/xapps/xapp_reliability_coverage","status":"off"},{"xapp_id":"xapp_throughput_efficiency","name":"Throughput Efficiency xApp","version":"2.0.0","description