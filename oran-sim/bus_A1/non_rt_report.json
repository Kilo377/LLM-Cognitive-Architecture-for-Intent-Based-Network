ervice.","entry_point":"xapp_fairness_scheduler","execution_type":"periodic","control_parameters":"scheduling.selectedUE","kpi_objectives":{},"kpi_constraints":{},"expected_standalone_effect":{},"path":"/Users/kilobao/Documents/MATLAB/Examples/R2025b/5g/5GORAN/oran-sim/xapps/xapp_fairness_scheduler","status":"off"},{"xapp_id":"xapp_interference_mitigator","name":"Interference Mitigator xApp","version":"1.0.0","description":"Continuously reduces transmit power to minimize interference and reduce BLER. This can decrease throughput and increase drop ratio.","entry_point":"xapp_interference_mitigator","execution_type":"periodic","control_parameters":"radio.txPowerOffset_dB","kpi_objectives":{},"kpi_constraints":{},"expected_standalone_effect":{},"path":"/Users/kilobao/Documents/MATLAB/Examples/R2025b/5g/5GORAN/oran-sim/xapps/xapp_interference_mitigator","status":"off"},{"xapp_id":"xapp_mobility_balancer","name":"Mobility Balancer xApp","version":"1.0.0","description":"Aggressively advances handover timing by reducing hysteresis and time-to-trigger. This accelerates cell changes but may increase handover count and ping-pong risk.","entry_point":"xapp_mobility_balancer","execution_type":"periodic","control_parameters":["handover.hysteresisOffset_dB","handover.tttOffset_slot"],"kpi_objectives":{},"kpi_constraints":{},"expected_standalone_effect":{},"path":"/Users/kilobao/Documents/MATLAB/Examples/R2025b/5g/5GORAN/oran-sim/xapps/xapp_mobility_balancer","status":"off"},{"xapp_id":"xapp_stability_guard","name":"Stability Guard xApp","version":"1.0.0","description":"Suppresses frequent handovers by increasing hysteresis. This improves stability but can delay cell changes.","entry_point":"xapp_stability_guard","execution_type":"periodic","control_parameters":"handover.hysteresisOffset_dB","kpi_objectives":{},"kpi_constraints":{},"expected_standalone_effect":{},"path":"/Users/kilobao/Documents/MATLAB/Examples/R2025b/5g/5GORAN/oran-sim/xapps/xapp_stability_guard","status":"off"},