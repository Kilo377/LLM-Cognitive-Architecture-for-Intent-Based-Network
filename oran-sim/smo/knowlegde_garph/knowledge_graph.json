    },
    {
      "id": "xapp:xapp_stability_guard",
      "type": "xapp",
      "name": "Stability Guard xApp",
      "meta": {
        "description": "Suppresses frequent handovers by increasing hysteresis. This improves stability but can delay cell changes."
      }
    },
    {
      "id": "kpi:ho_count",
      "type": "kpi",
      "name": "HO Count"
    },
    {
      "id": "xapp:xapp_throughput_maximizer",
      "type": "xapp",
      "name": "Throughput Maximizer xApp",
      "meta": {
        "description": "Maximizes throughput by selecting high-utility UEs and adaptively boosting bandwidth and power when PRB is saturated and SINR is low. Soft caps limit drop and BLER growth."
      }
    }
