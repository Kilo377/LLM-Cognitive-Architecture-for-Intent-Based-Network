    {
      "id": "xapp:xapp_drop_reducer",
      "type": "xapp",
      "name": "Drop Reducer xApp",
      "meta": {
        "description": "Reduces drop ratio by prioritizing buffered UEs with acceptable link quality using a lightweight contextual bandit. It may trade a small amount of throughput for lower drop and BLER."
      }
    },
    {
      "id": "param:scheduling.selectedUE",
      "type": "parameter",
      "name": "scheduling.selectedUE"
    },
