      "id": "xapp:xapp_capacity_booster",
      "type": "xapp",
      "name": "Capacity Booster xApp",
      "meta": {
        "description": "Continuously boosts transmit power and bandwidth to maximize throughput and reduce drop ratio. This can increase interference and energy consumption."
      }
    },
