      "name": "Top10Share"
    },
    {
      "id": "xapp:xapp_fairness_no_thr_loss",
      "type": "xapp",
      "name": "Fairness Guarded by Throughput",
      "meta": {
        "description": "Improve fairness by reweighting per-UE scheduling while enforcing a throughput guardrail based on an externally provided baseline. The xApp raises weightUE for low-throughput UEs only when windowed throughput stays within a small drop tolerance. It may increase drop ratio if fairness gains are large."
      }
    },
    {
      "id": "xapp:xapp_fairness_scheduler",
      "type": "xapp",
      "name": "Fairness Scheduler xApp",
      "meta": {
        "description": "Improves fairness by round-robin selection of UEs per cell. This can reduce peak throughput in exchange for more even service."
      }
    },
    {
      "id": "xapp:xapp_interference_mitigator",
      "type": "xapp",
      "name": "Interference Mitigator xApp",
      "meta": {
        "description": "Continuously reduces transmit power to minimize interference and reduce BLER. This can decrease throughput and increase drop ratio."
      }
    },
    {
      "id": "kpi:interference",
      "type": "kpi",
      "name": "Interference"
    },
    {
      "id": "xapp:xapp_mobility_balancer",
      "type": "xapp",
      "name": "Mobility Balancer xApp",
      "meta": {
        "description": "Aggressively advances handover timing by reducing hysteresis and time-to-trigger. This accelerates cell changes but may increase handover count and ping-pong risk."
      }
    },
    {
      "id": "param:handover.hysteresisOffset_dB",
      "type": "parameter",
      "name": "handover.hysteresisOffset_dB"
    },
