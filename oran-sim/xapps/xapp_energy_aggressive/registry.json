{
  "xapp_id": "xapp_energy_aggressive",
  "name": "Aggressive Energy Saver",
  "version": "1.0.0",

  "description": "This xApp maximizes energy efficiency by reducing transmit power, shrinking bandwidth, and putting low-load cells into sleep mode. It may reduce total throughput, degrade edge user SINR, and increase packet drop ratio under heavy load.",

  "control_parameters": [
    "radio.bandwidthScale",
    "radio.txPowerOffset_dB",
    "energy.basePowerScale",
    "sleep.cellSleepState"
  ],

  "kpi_objectives": {
    "efficiency.bitPerJ": "maximize"
  },

  "kpi_constraints": {
    "capacity.throughput_Mbps_total": {
      "type": "lower_bound",
      "value": 50
    }
  },

  "expected_standalone_effect": {
    "efficiency.bitPerJ": "significant_increase",
    "capacity.throughput_Mbps_total": "decrease",
    "phy.p10SINR_dB": "decrease",
    "reliability.dropRatio": "increase",
    "resource.meanInterference_dBm": "decrease"
  }
}